  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:start": "powershell -ExecutionPolicy Bypass -Command \"Remove-Item 'D:\\Program Files\\PostgreSQL\\data\\postmaster.pid' -Force -ErrorAction SilentlyContinue; & 'D:\\Program Files\\PostgreSQL\\bin\\pg_ctl.exe' start -D 'D:\\Program Files\\PostgreSQL\\data'\"",
    "db:status": "powershell -Command \"& 'D:\\Program Files\\PostgreSQL\\bin\\pg_ctl.exe' status -D 'D:\\Program Files\\PostgreSQL\\data'\"",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
